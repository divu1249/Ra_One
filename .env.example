# ==========================================
# RA.ONE 2.0 — ENVIRONMENT CONFIGURATION
# ==========================================
# Primary Tier-0 Provider (Google Gemini — resolves GEMINI_API_KEY, GOOGLE_API_KEY, or API_KEY)
GEMINI_API_KEY=
# GOOGLE_API_KEY=
# API_KEY=

# Tier-0 Hydra Failover Pool
GROQ_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=

# Tier-1 Local SLM Endpoint (OpenAI-compatible, e.g. Ollama / vLLM)
LOCAL_LLM_URL=

# Tier-0 / Pillar 5 Cloud Episodic Memory (Supabase pgvector)
SUPABASE_URL=
SUPABASE_KEY=

# Cognition Loop Tuning
MAX_ITERATIONS=5
SANDBOX_TIMEOUT_SECONDS=10

# Web Intelligence & Safe Self-Mutation Controls
TAVILY_API_KEY=
ALLOW_LIVE_MUTATIONS=false

# FreeLLMAPI Overflow Multi-Provider Router (tashfeenahmed/freellmapi)
FREELLMAPI_BASE_URL=
FREELLMAPI_API_KEY=
FREELLMAPI_MODEL_ACTOR=auto:coding
FREELLMAPI_MODEL_CRITIC=auto:smart
FREELLMAPI_MODEL_FAST=auto:fast
FREELLMAPI_PRIORITY=overflow